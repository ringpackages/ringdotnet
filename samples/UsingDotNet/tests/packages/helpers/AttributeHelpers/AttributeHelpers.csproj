<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET side of the tests of libraries that read attributes of classes: MessagePack ([MessagePackObject], [Key]) and CommandLineParser ([Option], [Value]). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>AttributeHelpers</AssemblyName>
    <RootNamespace>AttributeHelpers</RootNamespace>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>
</Project>
