<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ML.NET AutoML package and what it needs (a large restore: it brings the deep learning packages), kept apart from MlHelpers so that only the AutoML test restores it. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>MlAutoHelpers</AssemblyName>
    <RootNamespace>MlAutoHelpers</RootNamespace>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.1" />
    <PackageReference Include="Microsoft.ML.AutoML" Version="0.23.1" />
  </ItemGroup>
</Project>
