<!doctype html><html lang="en"><head><meta charset="utf-8"><title>RingDotNet documentation</title>
<base href="../"><link rel="stylesheet" href="assets/style.css"><style>%(css)s</style></head><body>
<section class="cover">%(cover)s</section>
