/*
	Generate the Ring wrapper classes of .NET types (like RingQt's generated classes).
	Usage:  ring gendotnet.ring            (from this folder, with ring_dotnet.dll on the PATH)

	Edit aTypes to add classes: [ .NET full type name , Ring class name ]
	Output: ../libraries/dotnetlib/generated/<ClassName>.ring and dotnetclasses.ring
*/

load "../libraries/dotnetlib/dotnetlib.ring"

C_OUTDIR = "../libraries/dotnetlib/generated/"

aTypes = [
	# [.NET type, Ring class, (optional) number of init() parameters]
	["System.Console","Console"],
	["System.Math","Math"],
	["System.Environment","Environment"],
	["System.Random","Random",1],
	["System.Guid","Guid"],
	["System.DateTime","DateTime"],
	["System.TimeSpan","TimeSpan"],
	["System.Text.StringBuilder","StringBuilder"],
	["System.IO.File","File"],
	["System.IO.Directory","Directory"],
	["System.IO.Path","Path"],
	["System.Diagnostics.Stopwatch","Stopwatch"],
	["System.Net.Http.HttpClient","HttpClient"],
	# Generic collections: one Ring class per closed type
	["System.Collections.Generic.List`1[[System.String]]","StringList",0],
	["System.Collections.Generic.List`1[[System.Double]]","NumberList",0],
	["System.Collections.Generic.List`1[[System.Object]]","ObjectList",0],
	["System.Collections.Generic.Dictionary`2[[System.String],[System.String]]","StringDictionary",0],
	["System.Collections.Generic.Dictionary`2[[System.String],[System.Double]]","NumberDictionary",0],
	["System.Collections.Generic.Dictionary`2[[System.String],[System.Object]]","ObjectDictionary",0],
	["System.Collections.Generic.HashSet`1[[System.String]]","StringSet",0],
	["System.Collections.Generic.Queue`1[[System.String]]","StringQueue",0],
	["System.Collections.Generic.Stack`1[[System.String]]","StringStack",0]
]

# Ring keywords can't be method names: add "_" at the end
aKeywords = split("if to or and not for foreach new func from next load else see while ok class return but end give bye exit try catch done switch on other off in loop package import private step do again call elseif put get set case def endfunc endclass endpackage endif endfor endwhile endswitch endtry function endfunction break continue this self super main init operator"," ")

func main
	aMap = []	# [canonical .NET name, Ring class] (canonical = the name the bridge reports for return types)
	for aType in aTypes
		aMap + [dnDescribe(aType[1])[1],aType[2]]
	next
	cList = ""
	for aType in aTypes
		? "Generating " + aType[2] + " from " + aType[1]
		nInitArity = -1
		if len(aType) >= 3
			nInitArity = aType[3]
		ok
		cCode = genClass(aType[1],aType[2],aMap,nInitArity)
		write(C_OUTDIR + aType[2] + ".ring",cCode)
		cList += 'load "' + aType[2] + '.ring"' + nl
	next
	write(C_OUTDIR + "dotnetclasses.ring","# Generated by tools/gendotnet.ring" + nl + cList)

func split cText, cSep
	return str2list(substr(cText,cSep,nl))

func ringName cName
	if find(aKeywords,lower(cName)) > 0
		return cName + "_"
	ok
	return cName

# Parameter list: P1,P2,...
func paraList nCount
	cList = ""
	for x = 1 to nCount
		if x > 1 cList += "," ok
		cList += "P" + x
	next
	return cList

# Ring class that wraps the .NET type, or "" when the type is not generated
func mappedClass cTypeName, aMap
	for aItem in aMap
		if aItem[1] = cTypeName
			return aItem[2]
		ok
	next
	return ""

# Statement that returns the result of a call (wrapped when its type is a generated class)
func returnCode cRequest, cReturnType, aMap
	if cReturnType = "System.Void"
		return "dnRequest(" + cRequest + ")" + nl + "		return self" + nl
	ok
	cClass = mappedClass(cReturnType,aMap)
	if cClass != ""
		return "return DotNetWrap_" + cClass + "(dnRequest(" + cRequest + "))" + nl
	ok
	return "return dnRequest(" + cRequest + ")" + nl

func genClass cTypeName, cClass, aMap, nForceInit
	aInfo = dnDescribe(cTypeName)
	lStatic = aInfo[2]
	aCtors = aInfo[3]
	aMethods = aInfo[4]
	aMembers = aInfo[5]
	cReserved = "|callmethod|getprop|setprop|tostring|typename|tolist|release|isnull|init|"

	cCode = "# Generated by tools/gendotnet.ring from " + cTypeName + " (do not edit)" + nl + nl
	nInit = -1	# the arity that has the most constructors (ties: the lower one)
	nBest = 0
	for aCtor in aCtors
		nCount = 0
		for aOther in aCtors
			if len(aOther) = len(aCtor)
				nCount++
			ok
		next
		if (nCount > nBest) or ((nCount = nBest) and (len(aCtor) < nInit))
			nInit = len(aCtor)
			nBest = nCount
		ok
	next
	if nForceInit >= 0
		nInit = nForceInit
	ok
	cWrap = ""
	# Wrap an existing .NET object (a returned value) as this class
	cWrap += "Func DotNetWrap_" + cClass + " xResult" + nl
	cWrap += "	if (not isobject(xResult)) or (xResult.nHandle = 0)" + nl
	cWrap += "		return xResult" + nl
	cWrap += "	ok" + nl
	cWrap += "	nDotNetWrapHandle = xResult.nHandle" + nl
	cWrap += "	return new " + cClass + "(" + copyParams(maxz(nInit)) + ")" + nl
	cCode += cWrap + nl + "Class " + cClass + " from DotNetObject" + nl + nl

	# Constructors: init uses the overload with fewer parameters, New_N the others
	cCode += "	Func init " + paraList(maxz(nInit)) + nl
	cCode += "		if nDotNetWrapHandle != 0" + nl
	cCode += "			nHandle = nDotNetWrapHandle" + nl
	cCode += "			nDotNetWrapHandle = 0" + nl
	cCode += "			return self" + nl
	cCode += "		ok" + nl
	if nInit >= 0
		cCode += "		nHandle = dnCreate('" + cTypeName + "',[" + paraList(nInit) + "])" + nl
	ok
	cCode += "		return self" + nl + nl
	aDone = [nInit]
	for aCtor in aCtors
		if find(aDone,len(aCtor)) = 0
			aDone + len(aCtor)
			cCode += "	Func New_" + len(aCtor) + " " + paraList(len(aCtor)) + nl
			cCode += "		nHandle = dnCreate('" + cTypeName + "',[" + paraList(len(aCtor)) + "])" + nl
			cCode += "		return self" + nl + nl
		ok
	next

	# Methods: the overload with the fewest parameters gets the plain name, others get Name_N
	aNames = ["init"]
	aSeen = []	# "static|name|arity"
	aMin = []	# [name, preferred arity]: the arity that has the most overloads (ties: the lower one)
	aCount = []	# [name|arity, count]
	for aMethod in aMethods
		cKey = lower(aMethod[1]) + "|" + len(aMethod[4])
		nPos = find(aCount,cKey,1)
		nWeight = 1
		for cType in aMethod[4]
			if isExoticType(cType)
				nWeight = 0	# overloads that need arrays, delegates or comparers don't decide the plain name
			ok
		next
		if nPos = 0
			aCount + [cKey,nWeight]
		else
			aCount[nPos][2] += nWeight
		ok
	next
	for aMethod in aMethods
		cKey = lower(aMethod[1])
		nPos = find(aMin,cKey,1)
		nCount = aCount[find(aCount,cKey + "|" + len(aMethod[4]),1)][2]
		if nPos = 0
			aMin + [cKey,len(aMethod[4]),nCount]
		but (nCount > aMin[nPos][3]) or ((nCount = aMin[nPos][3]) and (rankArity(len(aMethod[4])) < rankArity(aMin[nPos][2])))
			aMin[nPos][2] = len(aMethod[4])
			aMin[nPos][3] = nCount
		ok
	next
	for aMethod in aMethods
		cName = aMethod[1]
		nArity = len(aMethod[4])
		cLower = lower(cName)
		if substr(cReserved,"|" + cLower + "|")
			loop
		ok
		cKey = "" + aMethod[2] + "|" + cLower + "|" + nArity
		if find(aSeen,cKey) > 0
			loop
		ok
		aSeen + cKey
		cRing = ringName(cName)
		if nArity != aMin[find(aMin,cLower,1)][2]
			cRing = cName + "_" + nArity
		ok
		if find(aNames,lower(cRing)) > 0
			loop
		ok
		aNames + lower(cRing)
		if aMethod[2]
			cTarget = "dnTypeCached('" + cTypeName + "')"
		else
			cTarget = "self"
		ok
		cReq = '"call",[' + cTarget + ',"' + cName + '"'
		if nArity > 0
			cReq += "," + paraList(nArity)
		ok
		cReq += "]"
		cCode += "	Func " + cRing + " " + paraList(nArity) + nl
		cCode += "		" + returnCode(cReq,aMethod[3],aMap) + nl
	next

	# Indexer: Item(index) / SetItem(index,value)
	aIndexer = aInfo[6]
	if len(aIndexer) = 3
		cCode += "	Func Item P1" + nl
		cCode += "		" + returnCode('"call",[self,"get_Item",P1]',aIndexer[2],aMap) + nl
		if aIndexer[3]
			cCode += "	Func SetItem P1,P2" + nl
			cCode += '		dnRequest("call",[self,"set_Item",P1,P2])' + nl
			cCode += "		return self" + nl + nl
		ok
		aNames + "item"
		aNames + "setitem"
	ok

	# Properties and fields: getName() / setName(value)
	for aMember in aMembers
		cName = aMember[1]
		if aMember[4]
			cTarget = "dnTypeCached('" + cTypeName + "')"
		else
			cTarget = "self"
		ok
		if aMember[2] and (find(aNames,lower("get" + cName)) = 0)
			aNames + lower("get" + cName)
			cCode += "	Func get" + cName + nl
			cCode += "		" + returnCode('"get",[' + cTarget + ',"' + cName + '"]',aMember[5],aMap) + nl
		ok
		if aMember[3] and (find(aNames,lower("set" + cName)) = 0)
			aNames + lower("set" + cName)
			cCode += "	Func set" + cName + " P1" + nl
			cCode += '		dnRequest("set",[' + cTarget + ',"' + cName + '",P1])' + nl
			cCode += "		return self" + nl + nl
		ok
	next

	return cCode

func copyParams nCount
	cList = ""
	for x = 1 to nCount
		if x > 1 cList += "," ok
		cList += "0"
	next
	return cList

func maxz nValue
	if nValue < 0
		return 0
	ok
	return nValue

# On equal counts prefer the lowest arity, but a method with parameters beats a parameterless one
func rankArity nArity
	if nArity = 0
		return 99
	ok
	return nArity

func isExoticType cType
	for cPart in ["[]","Comparison","Func`","Action","Comparer","Predicate","Converter","Span","Memory","IFormatProvider","CancellationToken"]
		if substr(cType,cPart)
			return true
		ok
	next
	return false
