/*
	Entity Framework Core (with SQLite) for Ring programs.

	load "dotnetlib.ring"
	dnUseData()

	oDb = new RingDatabase("Data Source=people.db",[
		["Customers",[ ["Id","int",1], ["Name","string",0], ["Age","int",0], ["City","string",0] ]]
	])
	nId = oDb.insert("Customers",[["Name","Ann"],["Age",31],["City","Cairo"]])
	aRow = oDb.byKey("Customers",nId)			# [["Id",1],["Name","Ann"],["Age",31],["City","Cairo"]]
	? dbValue(aRow,"Name")
	for aCustomer in oDb.where("Customers","Age > {0} AND City = {1}",[18,"Cairo"])
		? dbValue(aCustomer,"Name")
	next
	oDb.update("Customers",nId,[["Age",32]])
	oDb.remove("Customers",nId)
	oDb.close()

	The model is described with data: [table, [[column, type, isKey], ...]], types: int long double decimal string bool datetime bytes.
	A key of type int/long is generated by the database. Rows are lists of [name, value] pairs.
	Conditions are SQL with {0} {1}... parameters (they are real SQL parameters: no injection).
	The classes of Microsoft.EntityFrameworkCore are wrapped too (dnImport("Microsoft.EntityFrameworkCore")).
*/

# The value of a column in a row: dbValue(aRow,"Name")
func dbValue  aRow, cColumn
	for db_aPair in aRow
		if lower(db_aPair[1]) = lower(cColumn)
			return db_aPair[2]
		ok
	next
	return ""

class RingDatabase

	db_oContext = ""

	func init  cConnection, aSchema
		db_oContext = dnRequest("call",[dnType("RingDotNet.RingDb, RingDotNet.Data"),"Create",cConnection,aSchema])

	# add a row, returns the key
	func insert  cTable, aValues
		return dnRequest("call",[db_oContext,"Insert",cTable,aValues])

	# the row with the key, or "" when there is none
	func byKey  cTable, xKey
		db_xRow = dnRequest("call",[db_oContext,"GetRow",cTable,xKey])
		if isobject(db_xRow)
			return ""
		ok
		return db_xRow

	func all  cTable
		return dnRequest("call",[db_oContext,"All",cTable])

	# rows that match a SQL condition with {0} {1} ... parameters
	func where  cTable, cCondition, aParameters
		return dnRequest("call",[db_oContext,"Where",cTable,cCondition,aParameters])

	func update  cTable, xKey, aValues
		return dnRequest("call",[db_oContext,"Update",cTable,xKey,aValues])

	func remove  cTable, xKey
		return dnRequest("call",[db_oContext,"Delete",cTable,xKey])

	func count  cTable
		return dnRequest("call",[db_oContext,"Count",cTable])

	# a SQL statement that changes data (parameters are {0} {1} ...): returns the number of rows
	func execute  cSql, aParameters
		return dnRequest("call",[db_oContext,"Execute",cSql,aParameters])

	# the first value of a SQL query
	func scalar  cSql
		return dnRequest("call",[db_oContext,"Scalar",cSql])

	# the EF Core DbContext (a DotNetObject) for everything else
	func context
		return db_oContext

	func close
		dnRequest("call",[db_oContext,"Close"])
