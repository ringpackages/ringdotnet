/*
	Entity Framework Core (with SQLite) for Ring programs.

	load "dotnetlib.ring"
	dnUseData()

	oDb = new RingDatabase("Data Source=people.db",[
		["Customers",[ ["Id","int",1], ["Name","string",0], ["Age","int",0], ["City","string",0] ]]
	])
	nId = oDb.insert("Customers",[["Name","Ann"],["Age",31],["City","Cairo"]])
	aRow = oDb.byKey("Customers",nId)			# [["Id",1],["Name","Ann"],["Age",31],["City","Cairo"]]
	? dbValue(aRow,"Name")
	for aCustomer in oDb.where("Customers","Age > {0} AND City = {1}",[18,"Cairo"])
		? dbValue(aCustomer,"Name")
	next
	oDb.update("Customers",nId,[["Age",32]])
	oDb.remove("Customers",nId)
	oDb.close()

	The model is described with data: [table, [[column, type, isKey], ...]], types: int long double decimal string bool datetime bytes.
	A column may have a 4th item: options [["required",1],["nullable",1],["unique",1],["index",1],["maxlength",40],["default",5]].
	Several columns with isKey = 1 make a composite key: byKey("Enrollments",[studentId,courseId]).
	Relationships: a column option ["references","Authors"] makes a foreign key (["ondelete","cascade"|"restrict"|"setnull"|"noaction"]);
	children("Authors",nId,"Books"), parent("Books",nId,"Authors") and include("Authors","Books") read the related rows.
	Providers: "Data Source=..." is SQLite; "inmemory:name" is the EF in-memory database (no SQL, no migrate); "sqlserver:...", "postgres:...",
	"mysql:..." use the EF Core package of that provider when its DLLs are next to RingDotNet.Data.dll (not bundled, not tested here).
	Columns of type "bytes" are hex texts (str2hex / hex2str) and datetime columns are "yyyy-MM-dd HH:mm:ss" texts.
	Table options (3rd item of a table): [["filter",condition]] is a global query filter (every read applies it; add ["ignorefilters",1] to a query to skip it).
	Column option ["convert","upper"|"lower"|"trim"] or ["convert",[dnCallback("toDb"),dnCallback("fromDb")]] converts a string column (the functions get [value] and return the new value).
	A key of type int/long is generated by the database. Rows are lists of [name, value] pairs.
	Conditions are SQL with {0} {1}... parameters (they are real SQL parameters: no injection).
	The classes of Microsoft.EntityFrameworkCore are wrapped too (dnImport("Microsoft.EntityFrameworkCore")).
*/

# The value of a column in a row: dbValue(aRow,"Name")
func dbValue  aRow, cColumn
	for db_aPair in aRow
		if lower(db_aPair[1]) = lower(cColumn)
			if isobject(db_aPair[2])		# a .NET null
				return ""
			ok
			return db_aPair[2]
		ok
	next
	return ""

# wait for a Task of the async methods and return its result
func dbWait  oTask
	oTask.Wait()
	return oTask.getProp("Result")

class RingDatabase

	db_oContext = ""
	db_cProvider = ""

	# cConnection is a SQLite connection string ("Data Source=people.db") or starts with the provider: "inmemory:shop",
	# "sqlserver:Server=.;Database=x;...", "postgres:Host=...", "mysql:Server=..." (those need the EF Core package of the provider
	# next to RingDotNet.Data.dll)
	func init  cConnection, aSchema
		db_cProvider = "sqlite"
		for db_cName in ["sqlite","inmemory","sqlserver","postgres","mysql"]
			if left(lower(cConnection),len(db_cName) + 1) = db_cName + ":"
				db_cProvider = db_cName
				cConnection = substr(cConnection,len(db_cName) + 2)
				exit
			ok
		next
		db_oContext = dnRequest("call",[dnType("RingDotNet.RingDb, RingDotNet.Data"),"CreateWith",db_cProvider,cConnection,aSchema])

	# add a row, returns the key
	func insert  cTable, aValues
		return dnRequest("call",[db_oContext,"Insert",cTable,aValues])

	# the row with the key, or "" when there is none
	func byKey  cTable, xKey
		db_xRow = dnRequest("call",[db_oContext,"GetRow",cTable,xKey])
		if isobject(db_xRow)
			return ""
		ok
		return db_xRow

	func all  cTable
		return dnRequest("call",[db_oContext,"All",cTable])

	# rows that match a SQL condition with {0} {1} ... parameters
	func where  cTable, cCondition, aParameters
		return dnRequest("call",[db_oContext,"Where",cTable,cCondition,aParameters])

	func update  cTable, xKey, aValues
		return dnRequest("call",[db_oContext,"Update",cTable,xKey,aValues])

	func remove  cTable, xKey
		return dnRequest("call",[db_oContext,"Delete",cTable,xKey])

	func count  cTable
		return dnRequest("call",[db_oContext,"Count",cTable])

	# a SQL statement that changes data (parameters are {0} {1} ...): returns the number of rows
	func execute  cSql, aParameters
		return dnRequest("call",[db_oContext,"Execute",cSql,aParameters])

	# the first value of a SQL query
	func scalar  cSql
		return dnRequest("call",[db_oContext,"Scalar",cSql])

	# the rows of cChildTable that belong to the row cParentTable/xKey (the child table has a column with ["references","ParentTable"])
	func children  cParentTable, xKey, cChildTable
		return dnRequest("call",[db_oContext,"Children",cParentTable,xKey,cChildTable])

	# the row of cParentTable that the row cChildTable/xKey belongs to, or ""
	func parent  cChildTable, xKey, cParentTable
		db_xRow = dnRequest("call",[db_oContext,"Parent",cChildTable,xKey,cParentTable])
		if isobject(db_xRow)
			return ""
		ok
		return db_xRow

	# all the rows of cTable with their related rows: [[row, children or parent row], ...]
	func include  cTable, cRelatedTable
		db_aList = dnRequest("call",[db_oContext,"Include",cTable,cRelatedTable])
		for db_aItem in db_aList
			if isobject(db_aItem[2])
				db_aItem[2] = ""
			ok
		next
		return db_aList

	# a query built as a LINQ expression tree (works with every provider): 
	#   oDb.query("Customers",[ ["where",["and",["Age",">",30],["City","in",["Cairo","Giza"]]]], ["orderby",[["Age","desc"]]], ["skip",10], ["take",5], ["select",["Name","Age"]] ])
	# conditions: [column, op, value] with op = != < <= > >= contains startswith endswith in isnull notnull; ["and",c1,c2,...] ["or",c1,c2,...] ["not",c]
	func query  cTable, aSpec
		return dnRequest("call",[db_oContext,"Query",cTable,aSpec])

	# count, sum, min, max or average of a column for the rows that match a condition ([] = all rows)
	func aggregate  cTable, cFunction, cColumn, aCondition
		if not islist(aCondition)
			aCondition = []
		ok
		return dnRequest("call",[db_oContext,"Aggregate",cTable,cFunction,cColumn,aCondition])

	func countWhere  cTable, aCondition
		return aggregate(cTable,"count","",aCondition)

	func sum  cTable, cColumn, aCondition
		return aggregate(cTable,"sum",cColumn,aCondition)

	func min  cTable, cColumn, aCondition
		return aggregate(cTable,"min",cColumn,aCondition)

	func max  cTable, cColumn, aCondition
		return aggregate(cTable,"max",cColumn,aCondition)

	func average  cTable, cColumn, aCondition
		return aggregate(cTable,"average",cColumn,aCondition)

	# [[value, count], ...] for each value of a column
	func groupCount  cTable, cColumn, aCondition
		if not islist(aCondition)
			aCondition = []
		ok
		return dnRequest("call",[db_oContext,"GroupCount",cTable,cColumn,aCondition])

	# the rows of any SELECT (any columns, joins, groups) as lists of [column, value]: sqlRows("SELECT City, COUNT(*) AS N FROM Customers GROUP BY City",[])
	func sqlRows  cSql, aParameters
		return dnRequest("call",[db_oContext,"SqlRows",cSql,aParameters])

	# hooks: Ring functions (dnCallback("name")) that run when changes are saved or SQL is executed; the function gets the list of arguments
	#   oDb.onSaving(dnCallback("checkChanges"))   # func checkChanges aArgs: aArgs[1] = [[table, state, row], ...]; return a text to cancel the save
	#   oDb.onSaved(dnCallback("afterSave"))       # aArgs[1] = the number of rows
	#   oDb.onLog(dnCallback("showSql"))           # aArgs[1] = the SQL text
	func onSaving  oCallback
		dnRequest("call",[db_oContext,"SetHook","saving",oCallback])

	func onSaved  oCallback
		dnRequest("call",[db_oContext,"SetHook","saved",oCallback])

	func onLog  oCallback
		dnRequest("call",[db_oContext,"SetHook","log",oCallback])

	# the changes waiting to be saved (with autoSave(false)): [[table, "Added"|"Modified"|"Deleted", row], ...]
	func pendingChanges
		return dnRequest("call",[db_oContext,"PendingChanges"])

	# migrations: bring an existing database in line with the model (creates the missing tables, columns and indexes);
	# returns the list of changes, for example ["add column Users.Email"]
	func migrate
		return dnRequest("call",[db_oContext,"Migrate"])

	# a named change (SQL) that is applied once: returns 1 when it was applied now, 0 when it had been applied before
	func apply  cName, cSql
		return dnRequest("call",[db_oContext,"Apply",cName,cSql])

	# the names of the applied changes
	func applied
		return dnRequest("call",[db_oContext,"Applied"])

	# transactions: begin() ... commit() or rollback(); an error in commit() undoes everything
	func begin
		dnRequest("call",[db_oContext,"Begin"])

	func commit
		dnRequest("call",[db_oContext,"Commit"])

	func rollback
		dnRequest("call",[db_oContext,"Rollback"])

	func inTransaction
		return dnRequest("get",[db_oContext,"InTransaction"])

	# async versions return a .NET Task: dbWait(oTask) waits and returns the result
	func insertAsync  cTable, aValues
		return dnRequest("call",[db_oContext,"InsertAsync",cTable,aValues])

	func allAsync  cTable
		return dnRequest("call",[db_oContext,"AllAsync",cTable])

	func whereAsync  cTable, cCondition, aParameters
		return dnRequest("call",[db_oContext,"WhereAsync",cTable,cCondition,aParameters])

	func countAsync  cTable
		return dnRequest("call",[db_oContext,"CountAsync",cTable])

	func saveAsync
		return dnRequest("call",[db_oContext,"SaveAsync"])

	# autoSave(false): changes are written when save() is called (one batch)
	func autoSave  lAuto
		dnRequest("set",[db_oContext,"AutoSave",lAuto])

	func save
		dnRequest("call",[db_oContext,"Save"])

	# forget the changes that were not saved (a failed save does this by itself)
	func discard
		dnRequest("call",[db_oContext,"Discard"])

	# a column of the model: [["name",..],["type",..],["key",..],["nullable",..],["required",..],["unique",..],["index",..],["maxlength",..]]
	func columnInfo  cTable, cColumn
		return dnRequest("call",[db_oContext,"ColumnInfo",cTable,cColumn])

	# the EF Core DbContext (a DotNetObject) for everything else
	func context
		return db_oContext

	func close
		dnRequest("call",[db_oContext,"Close"])

# Entity Framework Core with real entity classes. The tables of the schema (same format as RingDatabase) become .NET classes with one
# property per column, a navigation property to the parent for each foreign key (AuthorId --> Author) and a collection on the parent
# (Authors.Books). Entities are DotNetObjects: oBook.getProp("Title"), oBook.setProp("Title","x"), oBook.getProp("Author").
#
#   oDb = new RingEntityDb("Data Source=books.db",aSchema)
#   oBook = oDb.newEntity("Books")
#   oDb.fill(oBook,[["Title","The Hobbit"],["AuthorId",1]])
#   oDb.add(oBook)                                    # saved (autoSave)
#   for oB in oDb.query("Books",[ ["include",["Author"]], ["where",["Title","contains","Hobbit"]] ])
#       ? oB.getProp("Author").getProp("Name")
#   next
#   oBook.setProp("Title","The Hobbit, or There and Back Again")    # tracked: saved by save()
#   oDb.save()
class RingEntityDb

	db_oContext = ""

	func init  cConnection, aSchema
		db_cProvider = "sqlite"
		for db_cName in ["sqlite","inmemory","sqlserver","postgres","mysql"]
			if left(lower(cConnection),len(db_cName) + 1) = db_cName + ":"
				db_cProvider = db_cName
				cConnection = substr(cConnection,len(db_cName) + 2)
				exit
			ok
		next
		db_oContext = dnRequest("call",[dnType("RingDotNet.RingTypedDb, RingDotNet.Data"),"Create",db_cProvider,cConnection,aSchema])

	# a new entity (a DotNetObject of the generated class)
	func newEntity  cTable
		return dnRequest("call",[db_oContext,"New",cTable])

	# the .NET class (System.Type) of a table
	func entityType  cTable
		return dnRequest("call",[db_oContext,"EntityType",cTable])

	# the names of the properties of a table (columns, then navigations)
	func properties  cTable
		return dnRequest("call",[db_oContext,"Properties",cTable])

	# add an entity (with the entities it refers to); returns the key
	func add  oEntity
		return dnRequest("call",[db_oContext,"Add",oEntity])

	func remove  oEntity
		dnRequest("call",[db_oContext,"Remove",oEntity])

	# the entity with the key (a list for a composite key), or ""
	func find  cTable, xKey
		db_xEntity = dnRequest("call",[db_oContext,"FindEntity",cTable,xKey])
		if isobject(db_xEntity) and db_xEntity.isNull()
			return ""
		ok
		return db_xEntity

	# the entities that match a query: same specification as RingDatabase.query, plus ["include",["Navigation","Other.Nested"]]
	func query  cTable, aSpec
		return dnRequest("call",[db_oContext,"Query",cTable,aSpec])

	func all  cTable
		return dnRequest("call",[db_oContext,"All",cTable])

	func count  cTable, aCondition
		if not islist(aCondition)
			aCondition = []
		ok
		return dnRequest("call",[db_oContext,"Count",cTable,aCondition])

	# read / write a property of an entity (dates are texts, bytes are hex texts)
	func getValue  oEntity, cProperty
		db_xValue = dnRequest("call",[db_oContext,"Get",oEntity,cProperty])
		if isobject(db_xValue) and db_xValue.isNull()
			return ""
		ok
		return db_xValue

	func setValue  oEntity, cProperty, xValue
		dnRequest("call",[db_oContext,"Set",oEntity,cProperty,xValue])

	# the columns of an entity as [[name, value], ...]; fill() sets columns from such a list
	func toRow  oEntity
		return dnRequest("call",[db_oContext,"ToRow",oEntity])

	func fill  oEntity, aValues
		dnRequest("call",[db_oContext,"Fill",oEntity,aValues])

	func save
		dnRequest("call",[db_oContext,"Save"])

	func autoSave  lAuto
		dnRequest("set",[db_oContext,"AutoSave",lAuto])

	func discard
		dnRequest("call",[db_oContext,"Discard"])

	func begin
		dnRequest("call",[db_oContext,"Begin"])

	func commit
		dnRequest("call",[db_oContext,"Commit"])

	func rollback
		dnRequest("call",[db_oContext,"Rollback"])

	# the EF Core DbContext (a DotNetObject) for everything else
	func context
		return db_oContext

	func close
		dnRequest("call",[db_oContext,"Close"])
