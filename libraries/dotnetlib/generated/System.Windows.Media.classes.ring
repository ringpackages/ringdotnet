			nHandle = dnCreate('System.Windows.Media.DashStyle, PresentationCore',[])
			oDotNetGuard = dotnet_guard(nHandle)
			return self
		ok
		nHandle = dnCreate('System.Windows.Media.DashStyle, PresentationCore',[P1])
