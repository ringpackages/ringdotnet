Class NetworkChange from Object

	if nDotNetWrapHandle = 0 and nHandle = 0 and lower(classname(self)) = 'networkchange'          # new X without parentheses: the default object
		dnDefaultObject('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation')
	ok

	Func init 
		if nDotNetWrapHandle != 0
			nHandle = nDotNetWrapHandle
			nDotNetWrapHandle = 0
			oDotNetGuard = dotnet_guard(nHandle)          # this object owns the handle: it is released when the last copy is gone
			return self
		ok
		if nHandle != 0          # made by the class body
			return self
		ok
		if nHandle != 0          # the default object made for the class body is not needed
			dotnet_unguard(oDotNetGuard)
			dnRequest("release",[nHandle])
		ok
		nHandle = dnCreate('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation',[])
		oDotNetGuard = dotnet_guard(nHandle)
		return self

	Func Equals P1
		return dnRequest("call",[new DotNetObject(nHandle),"Equals",P1])

	Func RegisterNetworkChange P1
		dnRequest("call",[dnTypeCached('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation'),"RegisterNetworkChange",P1])
		return self

	Func setNetworkAvailabilityChangedEvent P1
		dnRequest("setevent",[dnTypeCached('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation'),"NetworkAvailabilityChanged",dnCallback(P1)])
		return self

	Func clearNetworkAvailabilityChangedEvent
		dnRequest("clearevent",[dnTypeCached('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation'),"NetworkAvailabilityChanged"])
		return self

	Func setNetworkAddressChangedEvent P1
		dnRequest("setevent",[dnTypeCached('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation'),"NetworkAddressChanged",dnCallback(P1)])
		return self

	Func clearNetworkAddressChangedEvent
		dnRequest("clearevent",[dnTypeCached('System.Net.NetworkInformation.NetworkChange, System.Net.NetworkInformation'),"NetworkAddressChanged"])
		return self


