Class rollback_hook_info from Object

	Func init P1,P2
		if nDotNetWrapHandle != 0
			nHandle = nDotNetWrapHandle
			nDotNetWrapHandle = 0
			oDotNetGuard = dotnet_guard(nHandle)          # this object owns the handle: it is released when the last copy is gone
			return self
		ok
		nHandle = dnCreate('SQLitePCL.rollback_hook_info, SQLitePCLRaw.core',[P1,P2])
		oDotNetGuard = dotnet_guard(nHandle)
		return self

	Func @call 
		dotnet_calltv(nHandle,"call")
		return self

	Func Equals P1
		dn_x = dotnet_call("s4:call",nHandle,"s6:Equals",P1)
		if islist(dn_x) return dnFinish(dn_x[2]) ok
		return dn_x

	Func from_ptr P1
		return dnObj(dotnet_callo("s4:call",'SQLitePCL.rollback_hook_info, SQLitePCLRaw.core',"s8:from_ptr",P1))


Class sqlite3 from SafeHandle

	Func init 
		if nDotNetWrapHandle != 0
			nHandle = nDotNetWrapHandle
			nDotNetWrapHandle = 0
			oDotNetGuard = dotnet_guard(nHandle)          # this object owns the handle: it is released when the last copy is gone
			return self
		ok
		return self

	Func manual_close_v2 
		return dnAnswer(dotnet_callt(nHandle,"manual_close_v2"))

	Func manual_close 
