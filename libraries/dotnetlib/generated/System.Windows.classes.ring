	Func init 
		if nDotNetWrapHandle != 0
			nHandle = nDotNetWrapHandle
			nDotNetWrapHandle = 0
			oDotNetGuard = dotnet_guard(nHandle)          # this object owns the handle: it is released when the last copy is gone
			return self
		ok
		return self

	Func ShouldSerializeInputBindings 
		return dnAnswer(dotnet_callt(nHandle,"ShouldSerializeInputBindings"))

	Func ShouldSerializeCommandBindings 
		return dnAnswer(dotnet_callt(nHandle,"ShouldSerializeCommandBindings"))

	Func RaiseEvent P1
		dotnet_callv("s4:call",nHandle,"s10:RaiseEvent",P1)

		return self

	Func AddHandler P1
		if dotnet_isnamed(P1)
			dotnet_callv("s9:callnamed",nHandle,"s10:AddHandler",P1)
			return self
		ok
		raise("DotNet Error: AddHandler does not take one argument: use named arguments, AddHandler([ :parameter = value, ... ])")

