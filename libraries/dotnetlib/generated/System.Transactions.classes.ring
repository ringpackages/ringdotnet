	Func InDoubt P1
		if dnIsNamed(P1)
			dnSend("s9:callnamed",nHandle,"s7:InDoubt",dnPackItem(P1))
			return self
		ok
		if isstring(P1) and P1 = ""
			dnSend("s4:call",nHandle,"s7:InDoubt","")
		return self
		ok
		dnSend("s4:call",nHandle,"s7:InDoubt",dnPackItem(P1))
		return self


Class SubordinateTransaction from Transaction

	Func init P1,P2
		if nDotNetWrapHandle != 0
			nHandle = nDotNetWrapHandle
			nDotNetWrapHandle = 0
			oDotNetGuard = dotnet_guard(nHandle)          # this object owns the handle: it is released when the last copy is gone
			return self
		ok
		nHandle = dnCreate('System.Transactions.SubordinateTransaction, System.Transactions.Local',[P1,P2])
		oDotNetGuard = dotnet_guard(nHandle)
		return self


