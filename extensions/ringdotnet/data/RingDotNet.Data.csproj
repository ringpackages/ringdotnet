<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>RingDotNet.Data</AssemblyName>
    <RootNamespace>RingDotNet</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.*" />
  </ItemGroup>

  <!-- The runtime is hosted by Ring (no app deps.json): the native SQLite library of Windows is copied next to the assemblies; the others are found in runtimes/<system>-<processor>/native by NativeSqlite.cs -->
  <Target Name="CopyNativeSqlite" AfterTargets="Build">
    <ItemGroup>
      <NativeFiles Include="$(OutDir)runtimes/win-x64/native/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
