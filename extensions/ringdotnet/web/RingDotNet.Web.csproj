<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>RingDotNet.Web</AssemblyName>
    <RootNamespace>RingDotNet</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime configuration used by dnUseWeb() (adds ASP.NET Core) -->
    <None Include="RingDotNet.Web.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="RingDotNet.All.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
